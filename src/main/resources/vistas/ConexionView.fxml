<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="480.0" prefHeight="360.0"
      style="-fx-background-color: #1e1e2e;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.vista.ConexionController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <Label text="MECHA DUEL" textFill="#89b4fa">
        <font><Font name="System Bold" size="28.0"/></font>
    </Label>
    <Label text="Conexión Multijugador por Sockets" textFill="#cdd6f4"/>

    <GridPane hgap="10" vgap="12" alignment="CENTER">
        <Label text="IP Contrincante:" textFill="#cdd6f4" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIp" text="127.0.0.1" promptText="Ej: 192.168.1.15" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Puerto:" textFill="#cdd6f4" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPuerto" text="5000" promptText="Ej: 5000" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="btnServidor" text="Crear Sala (Servidor)" onAction="#onCrearServidor"
                style="-fx-background-color: #a6e3a1; -fx-font-weight: bold;"/>
        <Button fx:id="btnCliente" text="Unirse (Cliente)" onAction="#onUnirseCliente"
                style="-fx-background-color: #89b4fa; -fx-font-weight: bold;"/>
    </HBox>

    <Label fx:id="lblEstado" text="Listo para conectar..." textFill="#f9e2af"/>
</VBox>